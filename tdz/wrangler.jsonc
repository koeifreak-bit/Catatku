{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vamsys-tdz",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Poll vAMSYS for new PIREPs every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  // KV namespace created on the first deploy (8 Nov 2026).
  "kv_namespaces": [{ "binding": "TDZ_KV", "id": "9fba588f2ae145149a6bba2f7c01c64f" }],
  "vars": {
    // Live since 8 Nov 2026 (single-PIREP test on 4111096 passed). "true" = score only, write nothing.
    "DRY_RUN": "false",
    // Maintenance auto-hide: live since 9 Nov 2026. "true" = track and log only.
    "MX_DRY_RUN": "false",
    // AOG from real-world ADS-B (adsb.lol): live since 9 Nov 2026. "true" = track and log only.
    "AOG_DRY_RUN": "false",
    // Discord bot (public values; the webhook URL is a secret set in the Cloudflare dashboard)
    "DISCORD_APP_ID": "1569925637009973298",
    "DISCORD_PUBLIC_KEY": "64f1a96bc722036a3b29aa472fcd508e81b036f56b23fa63bbce993c4f684c98"
  }
  // Secrets (never commit): wrangler secret put VAMSYS_CLIENT_ID / VAMSYS_CLIENT_SECRET / ADMIN_TOKEN
}
